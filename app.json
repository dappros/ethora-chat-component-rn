{
  "expo": {
    "name": "ethoraChatComponentRN",
    "slug": "ethora-chat-component-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.ethora.chatcomponentrn",
      "supportsTablet": false
    },
    "android": {
      "package": "com.ethora.chatcomponentrn",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "./plugins/withDisableExplicitModules",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "$(PRODUCT_NAME) needs access to your photos so you can attach images to chat messages.",
          "cameraPermission": "$(PRODUCT_NAME) needs access to your camera so you can take photos and send them in chat."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}

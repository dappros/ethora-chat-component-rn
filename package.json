    "expo-secure-store": ">=13.0.0",
    "expo-video": ">=2.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.73.0",
    "react-native-callkeep": ">=4.3.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-get-random-values": ">=1.10.0",

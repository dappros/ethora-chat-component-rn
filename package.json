{
  "name": "@ethora/chat-component-rn",
  "version": "26.7.3",
  "description": "Drop-in XMPP chat component for React Native / Expo. <Chat config={...}/> and you're done.",
  "main": "index.js",
  "module": "lib/module/main.js",
  "react-native": "lib/module/main.js",
  "source": "src/main.ts",
  "types": "lib/typescript/main.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./lib/typescript/main.d.ts",
        "default": "./lib/module/main.js"
      },
      "import": "./lib/module/main.js",
      "require": "./lib/commonjs/main.js",
      "types": "./lib/typescript/main.d.ts"
    },
    "./metro": "./metro.js"
  },
  "files": [
    "lib",
    "src",
    "metro.js",
    "empty-shim.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "**/{__tests__,__fixtures__,__mocks__}/**",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "peerDependencies": {
    "@livekit/react-native": ">=2.7.0",

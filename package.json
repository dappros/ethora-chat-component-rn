    "expo-secure-store": {
      "optional": true
    },
    "expo-video": {
      "optional": true
    }
  },
  "scripts": {
    "prepare": "patch-package && node scripts/install-git-hooks.js",
    "start": "expo start",
    "android": "node scripts/ensure-emulator.js && (expo run:android; node scripts/fix-prebuild-deps.js)",
    "ios": "expo run:ios; node scripts/fix-prebuild-deps.js",
    "web": "expo start --web",
    "prebuild": "expo prebuild; node scripts/fix-prebuild-deps.js",
    "fix-prebuild-deps": "node scripts/fix-prebuild-deps.js",
    "lint": "eslint .",
    "test": "jest",
    "build": "bob build",
    "clean": "rm -rf lib",
    "prepack": "npm run clean && npm run build",
    "e2e": "scripts/run-e2e.sh",
    "e2e:ios": "scripts/run-e2e.sh ios",
    "e2e:android": "scripts/run-e2e.sh android"
  },

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "lib/typescript",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "__tests__",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
